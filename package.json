{
    "name": "pvz-remake",
    "type": "3d",
    "version": "0.1.0",
    "uuid": "9814cd28-be9a-426e-9590-3aae15254ff3",
    "creator": {
        "version": "4.0.0-alpha.35"
    },
    "scripts": {
        "build:content": "python tools/build_pvz_base.py",
        "build:base-pack": "python tools/build_base_pack.py",
        "build:hd-pack": "python tools/build_hd_pack.py",
        "build:zh-cn-pack": "python tools/build_zh_cn_pack.py",
        "build:zh-cn-hd-pack": "python tools/build_zh_cn_hd_pack.py",
        "build:jiangnan-pack": "python tools/build_jiangnan_pack.py",
        "mod:init": "node tools/mod.mjs init",
        "mod:test": "node tools/mod.mjs test",
        "mod:pack": "node tools/mod.mjs pack",
        "typecheck:server": "tsc -p tsconfig.server.json",
        "test:server": "npm run typecheck:server && tsx --tsconfig tsconfig.server.json --test \"tests/**/*.test.ts\"",
        "preview:debug": "cocos preview --project .",
        "preview:release": "cocos preview --project . --no-debug",
        "build:web:debug": "cocos build --project . --platform web-mobile --build-config build-configs/debug.json --no-interactive",
        "build:web:release": "cocos build --project . --platform web-mobile --build-config build-configs/release.json --no-interactive",
        "build:macos:debug": "cocos build --project . --platform mac --build-config build-configs/macos-debug.json --no-interactive",
        "build:macos:release": "cocos build --project . --platform mac --build-config build-configs/macos-release.json --no-interactive",
        "compile:macos:debug": "npm run build:macos:debug && cocos make --platform mac --dest build/mac",
        "compile:macos:release": "npm run build:macos:release && cocos make --platform mac --dest build/mac",
        "build:windows:debug": "cocos build --project . --platform windows --build-config build-configs/debug.json --no-interactive",
        "build:windows:release": "cocos build --project . --platform windows --build-config build-configs/release.json --no-interactive",
        "compile:windows:debug": "npm run build:windows:debug && cocos make --platform windows --dest build/windows",
        "compile:windows:release": "npm run build:windows:release && cocos make --platform windows --dest build/windows",
        "build:android:arm64:debug": "cocos build --project . --platform android --build-config build-configs/android-arm64-debug.json --no-interactive",
        "build:android:arm64:release": "cocos build --project . --platform android --build-config build-configs/android-arm64-release.json --no-interactive",
        "compile:android:arm64:debug": "npm run build:android:arm64:debug && cocos make --platform android --dest build/android-arm64-debug",
        "compile:android:arm64:release": "npm run build:android:arm64:release && cocos make --platform android --dest build/android-arm64-release",
        "build:android:armv7:debug": "cocos build --project . --platform android --build-config build-configs/android-armv7-debug.json --no-interactive",
        "build:android:armv7:release": "cocos build --project . --platform android --build-config build-configs/android-armv7-release.json --no-interactive",
        "compile:android:armv7:debug": "npm run build:android:armv7:debug && cocos make --platform android --dest build/android-armv7-debug",
        "compile:android:armv7:release": "npm run build:android:armv7:release && cocos make --platform android --dest build/android-armv7-release"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.20.1",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "fflate": "0.8.3"
    }
}
