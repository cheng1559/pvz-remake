CCEffect %{
  techniques:
  - passes:
    - vert: mixed-vs:vert
      frag: mixed-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      rasterizerState: { cullMode: none }
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram mixed-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv;
  out vec4 color;
  vec4 vert () {
    uv = a_texCoord;
    color = a_color;
    return cc_matViewProj * vec4(a_position, 1.0);
  }
}%

CCProgram mixed-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  in vec2 uv;
  in vec4 color;
  vec4 frag () {
    vec4 pixel = CCSampleWithAlphaSeparated(cc_spriteTexture, uv) * vec4(color.rgb, abs(color.a));
    pixel.rgb *= pixel.a;
    if (color.a < 0.0) pixel.a = 0.0;
    return pixel;
  }
}%
