CCEffect %{
  techniques:
  - passes:
    - vert: mixed-vs:vert
      frag: mixed-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      rasterizerState: { cullMode: none }
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram mixed-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv;
  out vec4 color;
  vec4 vert () {
    uv = a_texCoord;
    color = a_color;
    return cc_matViewProj * vec4(a_position, 1.0);
  }
}%

CCProgram mixed-fs %{
  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 300])
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  in vec2 uv;
  in vec4 color;
  // Premultiplied, so that samples average by what they cover.
  vec4 texel (vec2 at) {
    vec4 pixel = CCSampleWithAlphaSeparated(cc_spriteTexture, at);
    pixel.rgb *= pixel.a;
    return pixel;
  }

  vec4 frag () {
    #if SUPERSAMPLED
      // Four samples to a screen pixel, at its quarters: the image as drawn at twice the size and halved, which is
      // what the original's cached frame scaled into a seed packet comes to. One sample falls among texels of art
      // several times the picture's size and skips the rest, so thin outlines come and go.
      #if __VERSION__ < 300
        #ifdef GL_OES_standard_derivatives
          vec2 dx = dFdx(uv) * 0.25, dy = dFdy(uv) * 0.25;
        #else
          vec2 dx = vec2(0.0), dy = vec2(0.0);
        #endif
      #else
        vec2 dx = dFdx(uv) * 0.25, dy = dFdy(uv) * 0.25;
      #endif
      vec4 pixel = (texel(uv - dx - dy) + texel(uv + dx - dy) + texel(uv - dx + dy) + texel(uv + dx + dy)) * 0.25;
    #else
      vec4 pixel = texel(uv);
    #endif
    float alpha = abs(color.a);
    pixel *= vec4(color.rgb * alpha, alpha);
    if (color.a < 0.0) pixel.a = 0.0;
    return pixel;
  }
}%
